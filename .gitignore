# ---------------------------------------------------------------------------
# What is deliberately NOT ignored: harness/results/.
# The archive statement of the thesis promises the raw responses, the scored
# outputs, the analysis summary, the annotation sheets and the outputs of the
# local-model experiments, so those files are tracked. Only caches, checkpoints
# and large binaries are excluded (see docs/ARCHIVE.md).
# ---------------------------------------------------------------------------

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Secrets - never commit
.env
.env.*
kaggle.json
*token*.txt

# Caches and in-flight checkpoints inside the results tree (regenerable, huge)
harness/results/.cache_core/
harness/results/**/*.partial.*
*.log
*.pid

# Large binaries. Hidden-state tensors are regenerated by the GPU kernels and
# are deposited as a separate large-file bundle, not in git (docs/ARCHIVE.md).
*.npz
*.npy
*.parquet
*.safetensors

# Model weights are never redistributed
*.bin
*.gguf

# Thesis build products (regenerated by thesis/v3/build.py and to_latex.py)
thesis/v3/html_build/
thesis/v3/latex/
thesis/v3/figures/
thesis/html_build/
thesis/latex/
thesis/figures/
_full.html
build_report.json
*.pdf
!docs/**/*.pdf

# Editors / OS
.DS_Store
.idea/
.vscode/
.ipynb_checkpoints/
